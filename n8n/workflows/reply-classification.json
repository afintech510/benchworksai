{
  "name": "Reply Classification + Routing",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "http://fastapi:8000/v1/reply-events?needs_review=true&limit=10",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "headers": { "parameters": [{ "name": "X-Service-Key", "value": "={{ $env.SERVICE_KEY_N8N }}" }] } }
      },
      "name": "Fetch Unclassified Replies",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "typeVersion": 4
    },
    {
      "parameters": {
        "url": "http://fastapi:8000/v1/classify-reply",
        "method": "POST",
        "body": {
          "reply_body": "={{ $json.reply_body }}",
          "lead_id": "={{ $json.lead_id }}",
          "reply_event_id": "={{ $json.id }}"
        },
        "options": { "headers": { "parameters": [{ "name": "X-Service-Key", "value": "={{ $env.SERVICE_KEY_N8N }}" }] } }
      },
      "name": "Classify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300],
      "typeVersion": 4
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.classification }}", "operation": "equals", "value2": "interested" },
            { "value1": "={{ $json.classification }}", "operation": "equals", "value2": "unsubscribe" },
            { "value1": "={{ $json.classification }}", "operation": "equals", "value2": "referral" }
          ]
        },
        "combineOperation": "any"
      },
      "name": "Route by Classification",
      "type": "n8n-nodes-base.switch",
      "position": [850, 300],
      "typeVersion": 2
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Fetch Unclassified Replies", "type": "main", "index": 0 }]] },
    "Fetch Unclassified Replies": { "main": [[{ "node": "Classify Reply", "type": "main", "index": 0 }]] },
    "Classify Reply": { "main": [[{ "node": "Route by Classification", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
