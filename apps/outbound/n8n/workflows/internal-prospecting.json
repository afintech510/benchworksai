{
  "id": "bw-internal-prospecting",
  "name": "F-007 Internal Prospecting (weekly)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 10 * * 1" }] } },
      "name": "Mondays 10:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "http://fastapi:8000/v1/internal/prospect-cycle?limit=25&score_threshold=70",
        "method": "POST",
        "options": {
          "timeout": 180000,
          "headers": {
            "parameters": [
              { "name": "X-Service-Key", "value": "={{ $env.SERVICE_KEY_N8N }}" }
            ]
          }
        }
      },
      "name": "Run Prospect Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "typeVersion": 4
    }
  ],
  "connections": {
    "Mondays 10:00 UTC": { "main": [[{ "node": "Run Prospect Cycle", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
