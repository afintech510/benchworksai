{
  "id": "bw-health-monitor",
  "name": "System Health Monitor (15m)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "http://fastapi:8000/v1/internal/health-check",
        "method": "POST",
        "options": {
          "timeout": 10000,
          "headers": {
            "parameters": [
              { "name": "X-Service-Key", "value": "={{ $env.SERVICE_KEY_N8N }}" }
            ]
          }
        }
      },
      "name": "Aggregate Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "typeVersion": 4
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.status }}", "operation": "notEqual", "value2": "healthy" }
          ]
        }
      },
      "name": "Any Failed?",
      "type": "n8n-nodes-base.if",
      "position": [650, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_ALERTS }}",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={ \"text\": \":rotating_light: Service health check failed: {{ $json.failed_services.join(', ') }}\" }",
        "options": {}
      },
      "name": "Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 250],
      "typeVersion": 4
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Aggregate Health Check", "type": "main", "index": 0 }]] },
    "Aggregate Health Check": { "main": [[{ "node": "Any Failed?", "type": "main", "index": 0 }]] },
    "Any Failed?": { "main": [[{ "node": "Slack Alert", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
